# Copie para .env e troque os valores. NUNCA versione o .env.
FLASK_CONFIG=development
SECRET_KEY=troque-por-uma-chave-aleatoria

POSTGRES_USER=gerlab
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gerlab
POSTGRES_TEST_DB=gerlab_test

# E-mails (SPEC-08). Em desenvolvimento deixe EMAIL_TRANSPORTE=log: o e-mail
# só aparece no log do serviço mailer. Em produção use smtp e preencha abaixo
# com a conta Gmail do projeto e uma SENHA DE APP (nunca a senha normal).
EMAIL_TRANSPORTE=log
EMAIL_REMETENTE=
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
